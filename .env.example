# .env.example - Rename to .env for local development

# 1. Telegram Bot Token (REQUIRED)
# Get this from BotFather on Telegram
TELEGRAM_TOKEN="YOUR_TELEGRAM_BOT_TOKEN_HERE"

# 2. Gemini API Key (REQUIRED)
# Get this from Google AI Studio
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 3. OpenAI API Key (OPTIONAL; used when Gemini is unavailable)
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY="YOUR_OPENAI_API_KEY"

# 4. Webhook URL (REQUIRED FOR DEPLOYMENT)
# This is the URL provided by Railway after deployment (e.g., https://my-ai-bot-production.up.railway.app)
# Railway will set this automatically, but you can set it manually for testing.
WEBHOOK_URL="YOUR_RAILWAY_URL"

# 5. Admin ID (REQUIRED)
# Mohammad's Telegram User ID for admin access
ADMIN_ID=33230000

# 6. Local Storage Path (For reference, not used in Railway deployment)
# The bot will use this path for memory and media storage on your local 1TB hard drive (D:/my_ai_bot/)
LOCAL_STORAGE_PATH="D:/my_ai_bot/"
